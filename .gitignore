# --- 体积大户：绝不入库 ---------------------------------------------------
# Cargo 构建目录（当前 9.0 GB）
/target/

# iPhone 拍摄素材，单条 56~312 MB，一共 952 MB。它们是 docs/TESTING.md 里
# 那些验收数据的相机侧输入，但录像本身不是源码，git 也不是存 HEVC 的地方。
/recordings/

# 发布产物：DMG / .app 打包件由 tools/build-macos.sh + tools/make-dmg.sh 重建，
# 图标由 `sendmecongo-bench icon` 用代码画出来。都可复现，所以不跟踪（当前 55 MB）。
/dist/

# 分析输出。**但 out/*.json 要留**：那是验收跑分的原始记录（goodput、黑洞时长、
# 解码率），而被测的录像不在仓库里 —— 也就是说这些 JSON 在仓库内无法复现，是唯一存证。
/out/*
!/out/*.json

# --- 零碎 -----------------------------------------------------------------
.DS_Store
__pycache__/

# 本地的开发笔记目录（.workbuddy/memory/*.md）：内容是本机这一轮开发的过程记录，
# 含绝对路径和定点的实机验证结果，跨机器/多人协作时会互相冲突，所以不入库。
/.workbuddy/
